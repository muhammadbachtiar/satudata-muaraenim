# Copy to .env.docker (git-ignored) and fill in the values marked CHANGE_ME.
# Read by docker compose via `env_file`, so it is NOT copied into the image.
# Do not use ${VAR} interpolation or inline comments in this file.

APP_NAME=SatuData
APP_ENV=production
APP_DEBUG=false
# CHANGE_ME: reuse the APP_KEY of the current server's .env so existing
# sessions/encrypted values stay valid. (New install: php artisan key:generate --show)
APP_KEY=
# CHANGE_ME: public URL, e.g. https://satudata.example.go.id
APP_URL=https://CHANGE_ME

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

# Logs go to `docker compose logs` (rotated by the json-file driver).
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Database: PostgreSQL on another server -----------------------------------
# Copy these values from the DB_* lines of the CURRENT production .env.
# Traffic from the container leaves through the host's public IP (NAT), so the
# pg_hba.conf / firewall rule that already allows this server keeps working.
DB_CONNECTION=pgsql
DB_HOST=CHANGE_ME
DB_PORT=5432
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
# Match what production uses today (disable, prefer, require, verify-full).
DB_SSLMODE=prefer

# --- Redis on the host: cache + session + queue ------------------------------
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_LIFETIME=120

REDIS_CLIENT=phpredis
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
# CHANGE_ME: required once Redis listens on a non-loopback address.
REDIS_PASSWORD=null
# CHANGE_ME: use DB numbers that no other app on this Redis uses
# (check with `redis-cli INFO keyspace`). `cache:clear` runs FLUSHDB on the
# cache DB, so sharing it with another app would wipe that app's data too.
REDIS_DB=5
REDIS_CACHE_DB=6
# Keys of this app are namespaced, so they never collide with other apps.
REDIS_PREFIX=satudata-database-
CACHE_PREFIX=satudata-cache-
# Must be greater than the job timeout (600 s) so a running job is not retried.
REDIS_QUEUE_RETRY_AFTER=660

# Set to true when the site is served over https (it is, behind the host nginx).
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
